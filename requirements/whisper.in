# OpenAI Whisper engine, CPU-only wheels from the PyTorch index.
#
# torch is pinned to a +cpu local-version build so the CUDA-bundled PyPI wheel
# can never match, regardless of index order. OpenAI Whisper does not use
# torchaudio, and the CPU index has not published a matching 2.13 release.
# Bump this pin when regenerating
# (`just lock`).
# Resolve across supported Python versions and constrain shared packages to
# runtime.txt / installer-build.txt; otherwise this export can downgrade the
# runtime (or select a numpy requiring a newer Python than the installer).
#
# The extra-index line below propagates into whisper.txt so plain
# `pip install -r requirements/whisper.txt` resolves against the CPU index.
--extra-index-url https://download.pytorch.org/whl/cpu

openai-whisper>=20231117
torch==2.13.0+cpu
